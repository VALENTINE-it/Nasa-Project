# AURA-MED Environment Variables
# Copy to .env and adjust as needed. Values shown are HACKATHON DEFAULTS ONLY.

# Backend
BACKEND_PORT=8080
# SQLite database path (relative to backend working directory)
DB_PATH=./data/aura_med.db
# Session cookie name
SESSION_COOKIE_NAME=aura_session
# Rate limit: max requests per minute per IP
MAX_REQUESTS_PER_MIN=60
# CORS allowed origins (comma-separated). Default: localhost dev origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Demo astronaut passwords (HACKATHON ONLY - change for production!)
DEMO_PASSWORD_A2041=mission-2041
DEMO_PASSWORD_A2056=mission-2056
DEMO_PASSWORD_A2089=mission-2089

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# Docker (single-origin mode)
# When running in Docker, the Go backend serves the frontend
# Set to 'true' to enable single-origin mode
SINGLE_ORIGIN=true